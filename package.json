{
  "name": "url-scraper",
  "version": "1.0.0",
  "description": "Scrape URLs to markdown with GitHub Actions automation",
  "type": "module",
  "scripts": {
    "scrape": "node scripts/scrape.js",
    "scrape:force": "node scripts/scrape.js --force",
    "docs:build": "node scripts/build-docs.mjs",
    "docs:serve": "node scripts/build-docs.mjs && npx --yes http-server site -p 8080"
  },
  "keywords": [
    "scraper",
    "markdown",
    "crawlee"
  ],
  "dependencies": {
    "crawlee": "^3.10.0",
    "got-scraping": "^4.1.5",
    "metascraper": "^5.29.2",
    "metascraper-author": "^5.29.2",
    "metascraper-date": "^5.29.2",
    "metascraper-description": "^5.29.2",
    "metascraper-image": "^5.29.2",
    "metascraper-title": "^5.29.2",
    "playwright": "^1.40.0",
    "rss-parser": "^3.13.0",
    "turndown": "^7.1.2"
  },
  "devDependencies": {
    "marked": "^15.0.12",
    "prettier": "^3.2.5"
  }
}
